# Smart Airport Command Center - Configuration Example
# Copy this file to `.env` and adjust values.
# IMPORTANT: Never commit real secrets. The SECRET_KEY below is a placeholder
# that must be overridden with a strong random value before any deployment.

# JWT signing key - GENERATE A RANDOM VALUE (do not reuse the placeholder)
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Alert Thresholds
# Queue length (people) thresholds
QUEUE_HIGH_THRESHOLD=100
QUEUE_MEDIUM_THRESHOLD=50
# Waiting time (minutes) thresholds
WAITING_HIGH_THRESHOLD=45
WAITING_MEDIUM_THRESHOLD=25
# Passenger flow thresholds
PASSENGER_CAPACITY_THRESHOLD=8000
PASSENGER_WARNING_THRESHOLD=5000

# Rate Limiting (in-memory sliding window per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60